{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#0d0507",
    "panel": "#170a0e",
    "element": "#221015",
    "foreground": "#f5e6ea",
    "muted": "#9b7b85",
    "crimson": "#e63946",
    "wine": "#8d2f4e",
    "alert": "#ff3b4e",
    "amber": "#e0a458",
    "violet": "#9d4edd",
    "blush": "#eeb4c2",
    "subtle": "#1d0d12"
  },
  "theme": {
    "primary": { "dark": "crimson", "light": "crimson" },
    "secondary": { "dark": "wine", "light": "wine" },
    "accent": { "dark": "crimson", "light": "crimson" },
    "error": { "dark": "alert", "light": "alert" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "violet", "light": "violet" },
    "info": { "dark": "blush", "light": "blush" },
    "text": { "dark": "foreground", "light": "foreground" },
    "textMuted": { "dark": "muted", "light": "muted" },
    "background": { "dark": "background", "light": "background" },
    "backgroundPanel": { "dark": "panel", "light": "panel" },
    "backgroundElement": { "dark": "element", "light": "element" },
    "border": { "dark": "wine", "light": "wine" },
    "borderActive": { "dark": "crimson", "light": "crimson" },
    "borderSubtle": { "dark": "subtle", "light": "subtle" },
    "diffAdded": { "dark": "violet", "light": "violet" },
    "diffRemoved": { "dark": "alert", "light": "alert" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "muted", "light": "muted" },
    "diffHighlightAdded": { "dark": "violet", "light": "violet" },
    "diffHighlightRemoved": { "dark": "alert", "light": "alert" },
    "diffAddedBg": { "dark": "#1c1024", "light": "#1c1024" },
    "diffRemovedBg": { "dark": "#2a0d12", "light": "#2a0d12" },
    "diffContextBg": { "dark": "panel", "light": "panel" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "#1c1024", "light": "#1c1024" },
    "diffRemovedLineNumberBg": { "dark": "#2a0d12", "light": "#2a0d12" },
    "markdownText": { "dark": "foreground", "light": "foreground" },
    "markdownHeading": { "dark": "blush", "light": "blush" },
    "markdownLink": { "dark": "crimson", "light": "crimson" },
    "markdownLinkText": { "dark": "blush", "light": "blush" },
    "markdownCode": { "dark": "amber", "light": "amber" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "blush", "light": "blush" },
    "markdownStrong": { "dark": "alert", "light": "alert" },
    "markdownHorizontalRule": { "dark": "muted", "light": "muted" },
    "markdownListItem": { "dark": "crimson", "light": "crimson" },
    "markdownListEnumeration": { "dark": "blush", "light": "blush" },
    "markdownImage": { "dark": "crimson", "light": "crimson" },
    "markdownImageText": { "dark": "blush", "light": "blush" },
    "markdownCodeBlock": { "dark": "foreground", "light": "foreground" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "wine", "light": "wine" },
    "syntaxFunction": { "dark": "blush", "light": "blush" },
    "syntaxVariable": { "dark": "foreground", "light": "foreground" },
    "syntaxString": { "dark": "amber", "light": "amber" },
    "syntaxNumber": { "dark": "violet", "light": "violet" },
    "syntaxType": { "dark": "crimson", "light": "crimson" },
    "syntaxOperator": { "dark": "wine", "light": "wine" },
    "syntaxPunctuation": { "dark": "foreground", "light": "foreground" }
  }
}
